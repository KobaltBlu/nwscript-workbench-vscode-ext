{
  "name": "nwscript-workbench",
  "displayName": "NWScript Workbench",
  "description": "A complete NWScript workbench for VS Code and compatible editors, with WebAssembly compilation, IntelliSense, navigation, and NCS inspection.",
  "version": "0.1.6",
  "publisher": "KobaltBlu",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/KobaltBlu/nwscript-workbench-vscode-ext.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "nwscript",
    "nss",
    "ncs",
    "kotor",
    "kotor2",
    "knights of the old republic",
    "modding",
    "wasm",
    "compiler",
    "workbench",
    "intellisense"
  ],
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true,
      "description": "Compilation uses the VS Code virtual file system API and works with browser-hosted workspaces."
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onCommand:nwscript.openHome",
    "onCommand:nwscript.openScriptBrowser",
    "onCommand:nwscript.openLanguageDefinitionBrowser",
    "onView:nwscript.sidebar",
    "onStartupFinished",
    "onLanguage:nwscript",
    "onCommand:nwscript.compileCurrentFile",
    "onCommand:nwscript.compileAllScripts",
    "onCommand:nwscript.compileFolder",
    "onCommand:nwscript.openCompiledNcs",
    "onCommand:nwscript.showCompilerLog",
    "onCommand:nwscript.disassembleNcs",
    "onCommand:nwscript.saveNcsDisassembly",
    "onCommand:nwscript.compareNcs",
    "onCommand:nwscript.openNcsForSource",
    "onCustomEditor:nwscript.ncsHex"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nwscript-workbench",
          "title": "NWScript Workbench",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "nwscript-workbench": [
        {
          "id": "nwscript.sidebar",
          "name": "NWScript Workbench",
          "type": "webview",
          "contextualTitle": "NWScript Workbench"
        }
      ]
    },
    "languages": [
      {
        "id": "nwscript",
        "aliases": [
          "NWScript",
          "nwscript"
        ],
        "extensions": [
          ".nss"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nwscript-asm",
        "aliases": [
          "NWScript Assembly",
          "NCS Assembly"
        ],
        "extensions": [
          ".ncsasm"
        ]
      }
    ],
    "grammars": [
      {
        "language": "nwscript",
        "scopeName": "source.nwscript",
        "path": "./syntaxes/nwscript.tmLanguage.json"
      },
      {
        "language": "nwscript-asm",
        "scopeName": "source.nwscript-asm",
        "path": "./syntaxes/nwscript-asm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nwscript",
        "path": "./snippets/nwscript.json"
      }
    ],
    "commands": [
      {
        "command": "nwscript.openHome",
        "title": "NWScript Workbench: Open Home",
        "icon": "$(home)"
      },
      {
        "command": "nwscript.openScriptBrowser",
        "title": "NWScript Workbench: Browse Scripts",
        "icon": "$(library)"
      },
      {
        "command": "nwscript.openLanguageDefinitionBrowser",
        "title": "NWScript Workbench: Browse Language Definitions",
        "icon": "$(references)"
      },
      {
        "command": "nwscript.compileCurrentFile",
        "title": "NWScript Workbench: Compile Current File",
        "icon": "$(play)"
      },
      {
        "command": "nwscript.compileAllScripts",
        "title": "NWScript Workbench: Compile All Scripts",
        "icon": "$(run-all)"
      },
      {
        "command": "nwscript.compileFolder",
        "title": "NWScript Workbench: Compile Folder…",
        "icon": "$(folder)"
      },
      {
        "command": "nwscript.openCompiledNcs",
        "title": "NWScript Workbench: Open Compiled NCS"
      },
      {
        "command": "nwscript.showCompilerLog",
        "title": "NWScript Workbench: Show Compiler Log",
        "icon": "$(output)"
      },
      {
        "command": "nwscript.disassembleNcs",
        "title": "NWScript Workbench: Open NCS Disassembly as Text"
      },
      {
        "command": "nwscript.saveNcsDisassembly",
        "title": "NWScript Workbench: Save NCS Disassembly…"
      },
      {
        "command": "nwscript.compareNcs",
        "title": "NWScript Workbench: Compare NCS Files…"
      },
      {
        "command": "nwscript.openNcsForSource",
        "title": "NWScript Workbench: Open NCS at Source"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nwscript.compileCurrentFile",
          "when": "resourceExtname == .nss",
          "group": "navigation"
        },
        {
          "command": "nwscript.openCompiledNcs",
          "when": "resourceExtname == .nss",
          "group": "navigation@2"
        },
        {
          "command": "nwscript.disassembleNcs",
          "when": "resourceExtname == .ncs || activeCustomEditorId == 'nwscript.ncsHex'",
          "group": "navigation"
        },
        {
          "command": "nwscript.saveNcsDisassembly",
          "when": "resourceExtname == .ncs || activeCustomEditorId == 'nwscript.ncsHex'",
          "group": "navigation@1"
        },
        {
          "command": "nwscript.compareNcs",
          "when": "resourceExtname == .ncs || activeCustomEditorId == 'nwscript.ncsHex'",
          "group": "navigation@2"
        },
        {
          "command": "nwscript.openNcsForSource",
          "when": "resourceExtname == .nss",
          "group": "navigation@1"
        },
        {
          "command": "nwscript.openHome",
          "when": "resourceExtname == .nss",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "nwscript.compileCurrentFile",
          "when": "resourceExtname == .nss",
          "group": "navigation@10"
        },
        {
          "command": "nwscript.openCompiledNcs",
          "when": "resourceExtname == .nss",
          "group": "navigation@10"
        },
        {
          "command": "nwscript.openNcsForSource",
          "when": "resourceExtname == .nss",
          "group": "navigation@11"
        }
      ],
      "explorer/context": [
        {
          "command": "nwscript.compileCurrentFile",
          "when": "resourceExtname == .nss",
          "group": "navigation@10"
        },
        {
          "command": "nwscript.compileFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "nwscript.compileAllScripts",
          "when": "workspaceFolderCount != 0",
          "group": "navigation@8"
        },
        {
          "command": "nwscript.openCompiledNcs",
          "when": "resourceExtname == .nss",
          "group": "navigation@10"
        },
        {
          "command": "nwscript.disassembleNcs",
          "when": "resourceExtname == .ncs",
          "group": "navigation@11"
        },
        {
          "command": "nwscript.saveNcsDisassembly",
          "when": "resourceExtname == .ncs",
          "group": "navigation@12"
        },
        {
          "command": "nwscript.compareNcs",
          "when": "resourceExtname == .ncs",
          "group": "navigation@13"
        },
        {
          "command": "nwscript.openNcsForSource",
          "when": "resourceExtname == .nss",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "NWScript Workbench",
      "properties": {
        "nwscript.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative directories searched before the workspace-wide NSS index when resolving #include resources.",
          "scope": "resource"
        },
        "nwscript.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative directory for generated NCS/NDB files. Empty writes beside the source NSS file.",
          "scope": "resource"
        },
        "nwscript.compileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Compile NWScript files when they are saved.",
          "scope": "resource"
        },
        "nwscript.liveDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Background-compile the active NSS buffer while typing. Does not write NCS or NDB.",
          "scope": "resource"
        },
        "nwscript.compileDependentsOnSave": {
          "type": "boolean",
          "default": false,
          "description": "When compile-on-save is enabled, recompile entry scripts that include a saved include file.",
          "scope": "resource"
        },
        "nwscript.inlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter name inlay hints on NWScript function and ACTION calls.",
          "scope": "resource"
        },
        "nwscript.semanticTokens": {
          "type": "boolean",
          "default": true,
          "description": "Overlay semantic highlighting for engine, include, and script symbols.",
          "scope": "resource"
        },
        "nwscript.formatting": {
          "type": "boolean",
          "default": true,
          "description": "Enable the conservative NWScript document formatter (brace indent).",
          "scope": "resource"
        },
        "nwscript.folding": {
          "type": "boolean",
          "default": true,
          "description": "Enable brace and grouped #include folding ranges.",
          "scope": "resource"
        },
        "nwscript.codeActions": {
          "type": "boolean",
          "default": true,
          "description": "Enable NWScript quick fixes (add include, create missing include, StartingConditional, language definition).",
          "scope": "resource"
        },
        "nwscript.includeGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show the active script's include graph on Workbench Home.",
          "scope": "window"
        },
        "nwscript.actionCompat": {
          "type": "boolean",
          "default": true,
          "description": "Compare ACTION signatures across workspace language specs on Home, the Language Definition Browser, and NCS Inspector details.",
          "scope": "window"
        },
        "nwscript.ncsReloadOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Reload the NCS Inspector when the open .ncs or sibling .ndb file changes on disk.",
          "scope": "resource"
        },
        "nwscript.ncsActionSignatures": {
          "type": "boolean",
          "default": true,
          "description": "Show Engine API ACTION names and signatures in the NCS Inspector.",
          "scope": "resource"
        },
        "nwscript.ncsNdbOverlay": {
          "type": "boolean",
          "default": true,
          "description": "Overlay sibling .ndb source mapping in the NCS Inspector when debug data is present.",
          "scope": "resource"
        },
        "nwscript.autoOpenHome": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open NWScript Workbench Home the first time a workspace is available after the extension activates. Turn this off to opt out of the welcome launch.",
          "scope": "window"
        },
        "nwscript.optimizationLevel": {
          "type": "string",
          "enum": [
            "O0",
            "O1",
            "O2",
            "O3"
          ],
          "default": "O1",
          "description": "Compiler optimization level.",
          "scope": "resource"
        },
        "nwscript.generateDebug": {
          "type": "boolean",
          "default": false,
          "description": "Generate NDB debug data when supported by the compiler.",
          "scope": "resource"
        },
        "nwscript.maxIncludeDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "default": 32,
          "description": "Maximum include depth accepted by the native compiler.",
          "scope": "resource"
        },
        "nwscript.maxResolveAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 64,
          "description": "Maximum number of missing include resources the extension will resolve and retry during one compilation.",
          "scope": "resource"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "nwscript.ncsHex",
        "displayName": "NWScript Workbench NCS Inspector",
        "selector": [
          {
            "filenamePattern": "*.ncs"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "npm run check-types && node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "package": "npm run build && vsce package",
    "test-web": "npm run build && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "vscode:prepublish": "npm run build",
    "package:list": "npm run build && vsce ls",
    "publish:vscode": "npm run build && vsce publish",
    "publish:openvsx": "npm run build && ovsx publish"
  },
  "dependencies": {
    "@neverwinter/nwscript-wasm": "https://codeload.github.com/KobaltBlu/nwscript-wasm/tar.gz/refs/heads/master"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "ovsx": "^0.10.4",
    "typescript": "^5.9.0"
  },
  "homepage": "https://github.com/KobaltBlu/nwscript-workbench-vscode-ext",
  "bugs": {
    "url": "https://github.com/KobaltBlu/nwscript-workbench-vscode-ext/issues"
  },
  "icon": "assets/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0b1320",
    "theme": "dark"
  }
}
