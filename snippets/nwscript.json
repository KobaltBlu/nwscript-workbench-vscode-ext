{
  "Main function": {
    "prefix": "main",
    "body": [
      "void main()",
      "{",
      "  $0",
      "}"
    ],
    "description": "NWScript main entry point"
  },
  "Starting Conditional": {
    "prefix": "StartingConditional",
    "body": [
      "int StartingConditional()",
      "{",
      "  $0",
      "  return TRUE;",
      "}"
    ],
    "description": "Starting conditional that returns TRUE or FALSE"
  },
  "Include": {
    "prefix": "include",
    "body": "#include \"${1:k_inc_}\"",
    "description": "Include an NSS resource"
  },
  "DelayCommand": {
    "prefix": "DelayCommand",
    "body": "DelayCommand(${1:0.5}, ${2:ActionDoCommand(ActionSpeakString(\"${3:text}\"))});",
    "description": "Schedule an action after a delay"
  },
  "AssignCommand": {
    "prefix": "AssignCommand",
    "body": "AssignCommand(${1:oTarget}, ${2:ActionSpeakString(\"${3:text}\")});",
    "description": "Queue an action on another object"
  },
  "ActionDoCommand": {
    "prefix": "ActionDoCommand",
    "body": "ActionDoCommand(${1:ActionSpeakString(\"${2:text}\")});",
    "description": "Queue an action on the caller"
  },
  "Conversation script": {
    "prefix": "convmain",
    "body": [
      "void main()",
      "{",
      "  object oSpeaker = GetLastSpeaker();",
      "  $0",
      "}"
    ],
    "description": "Conversation node script using GetLastSpeaker"
  },
  "Apply effect": {
    "prefix": "effect",
    "body": [
      "effect e${1:Effect} = Effect${1:VisualEffect}(${2:VFX_IMP_HEALING_S});",
      "ApplyEffectToObject(DURATION_TYPE_${3:INSTANT}, e${1:Effect}, ${4:OBJECT_SELF}${5:, 0.0});"
    ],
    "description": "Create and apply an effect"
  },
  "Item property": {
    "prefix": "itemprop",
    "body": [
      "itemproperty ip${1:Prop} = ItemProperty${2:DamageBonus}(${3:IP_CONST_DAMAGETYPE_FIRE}, ${4:IP_CONST_DAMAGEBONUS_1d4});",
      "AddItemProperty(DURATION_TYPE_${5:PERMANENT}, ip${1:Prop}, ${6:oItem}${7:, 0.0});"
    ],
    "description": "Create and add an item property"
  },
  "GetScriptParameter": {
    "prefix": "GetScriptParameter",
    "body": "GetScriptParameter(${1:1})",
    "description": "K2/TSL script parameter from a conversation node"
  }
}
